# 配置模板 —— 复制为 .env 后填入真实值
#
# cp .env.example .env
# chmod 600 .env
#
# ⚠️ LightRAG 用 load_dotenv(override=False)，不支持 ${VAR} 插值，
#    所有密钥必须写字面值。
#
#三路模型策略：
#   Embedding 本地 bge-m3        换 API 会导致向量空间不兼容，需重建知识库
#   LLM       中转站 API         抽取质量的关键
#   Reranker  阿里云 gte-rerank-v2
#   VLM       阿里云 qwen-vl-max  仅处理 PDF 内嵌图片

################################################################################
# 个人 RAG 知识库配置
#
# 三路模型策略（刻意混搭，各取所长）：
#   Embedding —— 本地 bge-m3     换API 会导致向量空间不兼容，需重建知识库；
#                                放在本地也避免文档内容外泄
#   LLM       —— 中转站 API      抽取/生成质量的关键，量小但要求高
#   Reranker  —— 阿里云 gte-rerank-v2   收益最大的一项，交叉编码器精排
#   VLM       —— 阿里云 qwen-vl-max     仅处理 PDF 里的图片
#
# ⚠️ 密钥填写：LightRAG 用 load_dotenv(override=False)，不支持 ${VAR} 插值，
#    必须写字面值。改完 chmod 600。
################################################################################

# ---------------------------------------------------------------- 服务绑定
HOST=127.0.0.1
PORT=9621
LIGHTRAG_WEBUI_ENABLED=true
WEBUI_TITLE=我的知识库

WORKING_DIR=./data/knowledge
INPUT_DIR=./input
LOG_LEVEL=INFO

################################################################################
# LLM：中转站（OpenAI 兼容端点）
#
# 实体抽取要求稳定的 JSON 输出，选模型时优先看结构化输出能力，
# 不要只看参数量。抽取质量决定知识图谱质量，入库阶段出错后面无法补救。
#
# 上下文窗口需≥ MAX_TOTAL_TOKENS + 2000，中转站模型一般给 32k 以上，无忧。
################################################################################
LLM_BINDING=openai
LLM_BINDING_HOST=https://your-relay-endpoint/v1
LLM_BINDING_API_KEY=sk-REPLACE_ME
LLM_MODEL=your-model-name

# 入库阶段并发可高些；注意中转站的并发与限流策略，报 429 就调低
MAX_ASYNC_LLM=6
LLM_TIMEOUT=180
EXTRACT_LLM_TIMEOUT=240
EXTRACT_MAX_ASYNC_LLM=6

SUMMARY_LANGUAGE=Chinese
ENTITY_EXTRACTION_USE_JSON=true

################################################################################
# Embedding：本地 bge-m3（保持不变）
#
# 换模型必须重建整个知识库 —— 向量空间不兼容，旧向量无法与新模型的
# 查询向量比较。留在本地还有个好处：文档内容不外泄。
################################################################################
EMBEDDING_BINDING=ollama
EMBEDDING_BINDING_HOST=http://localhost:11434
EMBEDDING_BINDING_API_KEY=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_TOKEN_LIMIT=8192
OLLAMA_EMBEDDING_NUM_CTX=8192
EMBEDDING_TIMEOUT=60
MAX_ASYNC_EMBEDDING=4

################################################################################
# Reranker：阿里云 gte-rerank-v2
#
# 收益最大的一项配置。交叉编码器把 query 和文档拼在一起逐对打分，
# 能判断「这段是否真能回答这个问题」；而双编码器的余弦相似度只衡量
# 字面像不像。Top60 候选经精排后，送进 LLM 的片段质量明显提升。
#
# ⚠️ reranker 的输入是原始文本，会发给阿里云。
################################################################################
RERANK_BINDING=aliyun
RERANK_MODEL=gte-rerank-v2
RERANK_BINDING_HOST=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_BINDING_API_KEY=sk-REPLACE_ME
RERANK_BY_DEFAULT=True
# 低于该分数的片段直接丢弃，是抑制噪声的第一道闸
MIN_RERANK_SCORE=0.3
MAX_ASYNC_RERANK=4
RERANK_TIMEOUT=30

################################################################################
# VLM：阿里云 qwen-vl-max（处理 PDF 内嵌图片）
#
# ⚠️ 两个必要条件，缺一个都不生效：
#   1) VLM_PROCESS_ENABLE=true
#   2) 文档的解析规则要带 i 选项（LIGHTRAG_PARSER 里配置），
#      否则图片分析根本不会被触发 —— 默认的 *:native-teP 不含 i，
#      含图的文档会直接被判定失败而非跳过。
#
# 日常 md / 代码不需要VLM，保持关闭即可，省钱。
################################################################################
VLM_PROCESS_ENABLE=false
VLM_LLM_BINDING=openai
VLM_LLM_BINDING_HOST=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_LLM_BINDING_API_KEY=sk-REPLACE_ME
VLM_LLM_MODEL=qwen-vl-max
VLM_MAX_IMAGE_BYTES=5242880
VLM_MIN_IMAGE_PIXEL=64
VLM_MAX_ASYNC_LLM=2
VLM_LLM_TIMEOUT=180

################################################################################
# 检索质量调优
################################################################################
# local   低层实体细节，快，适合"XX 函数在哪定义"
# global  高层关系概括，适合"整体讲了什么"
# hybrid  均衡
# mix     全局+局部+关键词，最全，稍慢
QUERY_MODE=mix

# 候选数量。开了 reranker 后可以放宽召回，因为精排会做筛选
TOP_K=60
CHUNK_TOP_K=15

# 余弦阈值：向量层面的粗筛，防明显不相关的
COSINE_Better_Than_Threshold=0.2

RELATED_CHUNK_NUMBER=12
MAX_TOTAL_TOKENS=12000

################################################################################
# 分块策略
# md 为主 → Paragraph 按标题/段落结构切分，实测切分点落在标题边界上，
# 不会拦腰截断章节。单节超长时会 overlap 重复计入相邻两块。
# 投喂整个代码仓库（单文件上万行）建议改 recursive，按语法边界切。
################################################################################
CHUNKING_STRATEGY=paragraph
CHUNK_SIZE=1200
CHUNK_OVERLAP_SIZE=100
CHUNK_P_SIZE=1200
CHUNK_P_OVERLAP_SIZE=100

################################################################################
# 存储：JSON 文件落盘，轻量、可直接备份、可 diff
#
# 1.5.7 版实现名已改，不要照抄旧教程：
#   JsonVectorStorage → NanoVectorDBStorage
#   文档状态必须用 JsonDocStatusStorage，不能用 JsonKVStorage
################################################################################
LIGHTRAG_KV_STORAGE=JsonKVStorage
LIGHTRAG_VECTOR_STORAGE=NanoVectorDBStorage
LIGHTRAG_GRAPH_STORAGE=NetworkXStorage
LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage